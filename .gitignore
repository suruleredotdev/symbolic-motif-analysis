# Generated analysis outputs — large, regenerable, not committed
# (no trailing slash: frobenius_artifacts may be a symlink into african-artifacts)
analysis/
frobenius_artifacts

# Source images (gitignored — fetch/download separately)
images/

# Python toolchain
.venv/
__pycache__/
**/__pycache__/
*.pyc
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Model checkpoints (large binaries — download separately, see README)
*.pth
*.pt
sam2*.yaml

# Collaborator share bundles built by make_subset.sh (contain restricted images)
subset_share/
subset_share*.tar.gz

# Per-labeller output from motif_labeling.ipynb (MOTIF_LABELER=<name>)
motif_labels.*.json

# OS / editor cruft
.DS_Store
*.swp
